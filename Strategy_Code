# Candle timeframe in minutes. Default = 5.
# Examples: 1, 3, 5, 15, 30, 60, 120, 240, 1440 (1D)
TIMEFRAME_MINUTES = 5

# Derived constants (do not edit manually)
TIMEFRAME_MS = TIMEFRAME_MINUTES * 60 * 1000
# CoinDCX interval string used by the REST candles endpoint
