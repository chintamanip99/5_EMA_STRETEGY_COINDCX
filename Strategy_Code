    1: "1m", 3: "3m", 5: "5m", 15: "15m", 30: "30m",
    60: "1h", 120: "2h", 240: "4h", 1440: "1d",
}
COINDCX_INTERVAL = _INTERVAL_MAP.get(TIMEFRAME_MINUTES, f"{TIMEFRAME_MINUTES}m")
# CoinDCX WebSocket channel suffix for this timeframe
WS_CHANNEL_SUFFIX = COINDCX_INTERVAL

# ==================== RISK / REWARD CONFIG ====================
# Risk per trade as fraction of balance (e.g. 0.01 = 1%)
RISK_PER_TRADE = 0.01

# Reward multiple relative to risk (e.g. 10 means TP = entry + 10*risk)
# 1% risk : 10% reward  =>  RISK_PER_TRADE=0.01, REWARD_MULTIPLE=10
REWARD_MULTIPLE = 10.0

