# ==================== MAIN PROCESSING ====================

def process_data(df: pd.DataFrame, is_candle_close: bool = False):
    global position, alert_candle

    try:
        df = calculate_indicators(df)
        current_price = float(df['Close'].iloc[-1])

        # 1. Manage open position
        if position is not None:
            position, closed = manage_position(df, position, current_price)
            if closed:
                alert_candle = None

        # 2. Live breakout check on the immediately next candle
        if position is None and alert_candle is not None:
            breakout, invalidated, fill_price = check_breakout_live(
                df,
                alert_candle['data'],
                alert_candle['type'],
                alert_candle['timestamp'],
            )
            if breakout:
                new_pos = enter_position(
                    alert_candle['data'],
                    alert_candle['type'],
                    entry_price=fill_price,
                    entry_candle_ts=int(df['timestamp'].iloc[-1]),
                )
                if new_pos is not None:
                    position = new_pos
                    alert_candle = None
            elif invalidated:
                print(f"\n⚠️ {alert_candle['type'].upper()} alert INVALIDATED — "
                      f"next candle closed without breakout.")
                alert_candle = None

        # 3. Detect a new alert ONLY on candle close
        if is_candle_close and position is None and alert_candle is None and len(df) >= 6:
            df, verified = sync_closed_candle(df)
            if verified or not REQUIRE_VERIFIED_CANDLE:
                if not verified:
                    print("\n⚠️ Could not verify closed candle via REST; using websocket data.")
                detected, alert_type, alert_idx = check_alert_candle(df)
                if detected is not None:
                    alert_ts = int(detected['timestamp'])
                    alert_candle = {
                        'data': detected,
                        'type': alert_type,
                        'timestamp': alert_ts,
                        'candle_index': alert_idx,
                    }
                    print(f"\n\n🚨 NEW {alert_type.upper()} ALERT CANDLE DETECTED [{TIMEFRAME_MINUTES}m]!")
                    print_alert_details(df, detected, alert_type)
            else:
                print("\n⏭️ Closed candle could not be verified via REST — alert check skipped.")

        print_status_line(df, position, alert_candle)

    except Exception as e:
        print(f"\n❌ Processing error: {e}")
        import traceback
        traceback.print_exc()


# ==================== WEBSOCKET FUNCTIONS ====================

def _bucket_ts(ts_ms: int) -> int:
    return (int(ts_ms) // TIMEFRAME_MS) * TIMEFRAME_MS


def start_websocket():
    socketEndpoint = 'wss://stream.coindcx.com'
    sio = socketio.Client()
    global full_data, candle_counter

    channel = f"{PAIR}_{WS_CHANNEL_SUFFIX}-futures"

    @sio.event
    def connect():
        print("\n✅ Connected to WebSocket!")
        sio.emit('join', {'channelName': channel})
        print(f"✅ Subscribed to {channel}\n")

    @sio.on('candlestick')
    def on_message(response):
        global full_data, candle_counter, last_processed_candle_ts
        try:
            data = None
            if isinstance(response, dict):
                if 'data' in response:
                    try:
                        data_json = json.loads(response['data'])
                        if isinstance(data_json, dict) and 'data' in data_json:
                            data = data_json['data']
                            if isinstance(data, list) and len(data) > 0:
                                data = data[0]
                        else:
                            data = data_json
                    except Exception:
                        data = response
                else:
                    data = response
            else:
                data = response

            if not isinstance(data, dict):
                return

            o = float(data.get('open', 0))
            h = float(data.get('high', 0))
            l = float(data.get('low', 0))
            c = float(data.get('close', 0))
            v = float(data.get('volume', 0))
            if not all([o > 0, h > 0, l > 0, c > 0]):
                return

            raw_ts = data.get('time', data.get('timestamp', time.time() * 1000))
            ts = _bucket_ts(int(raw_ts))

            ohlcv = {
                'Open': o, 'High': h, 'Low': l, 'Close': c, 'Volume': v,
                'timestamp': ts, 'sequence': candle_counter,
            }

            candle_closed = False
            if full_data and full_data[-1]['timestamp'] == ts:
                full_data[-1] = ohlcv
            else:
                if full_data and full_data[-1]['timestamp'] != ts:
                    candle_closed = True
                    last_processed_candle_ts = full_data[-1]['timestamp']
                candle_counter += 1
                ohlcv['sequence'] = candle_counter
                full_data.append(ohlcv)

            if len(full_data) > 1000:
                full_data = full_data[-1000:]
            full_data = clean_full_data(full_data)

            if len(full_data) >= LOOKBACK:
                df = pd.DataFrame(full_data)
                process_data(df, is_candle_close=candle_closed)

        except Exception as e:
            print(f"\n❌ WebSocket error: {e}")

    @sio.event
    def disconnect():
        print("\n❌ Disconnected from WebSocket")

    try:
        print("🔌 Connecting to WebSocket...")
        sio.connect(socketEndpoint, transports=['websocket'])
        sio.wait()
    except Exception as e:
        print(f"❌ Connection failed: {e}")


